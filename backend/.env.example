# ============================================================
# Vonage Video Reservation - 環境変数サンプル
# 実際の値を設定した .env を backend/ 直下に配置してください
# ============================================================

# --- Server ---
PORT=4000
NODE_ENV=development
# フロントエンド SPA のオリジン（CORS 許可用）
CLIENT_ORIGIN=http://localhost:5173

# --- 公開アプリ URL（入室リンクの配信先）---
# WhatsApp で配信する入室リンクのベース URL。利用者の端末（スマホ）で開かれるため
# localhost は使えません。CLIENT_ORIGIN（CORS 用）とは別の設定です。
#   テスト: Cloudflare クイックトンネル
#     cloudflared tunnel --url http://localhost:5173
#     → 表示された https://<ランダム>.trycloudflare.com を設定
#   本番: デプロイ先の公開 URL（例: https://app.example.com）
# 未設定または localhost のままでは入室リンクの発行が fail-closed で拒否されます。
# 末尾のスラッシュは不要（除去される）。
PUBLIC_APP_URL=

# --- MongoDB Atlas ---
# 例: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=video_reservation

# --- JWT / Auth (RBAC) ---
JWT_SECRET=
# アクセストークン有効期限（例: 1h, 30m, 7d）
JWT_EXPIRES_IN=1h

# --- Vonage Video API (旧 OpenTok) ---
# Video API アプリケーション ID と秘密鍵ファイルパス。
# 秘密鍵ファイルは backend/ 直下に置き、パスは backend/ を基準とした相対パスで指定する
# （アプリは cwd=backend で起動するため）。
# Messages と Video を同一 Application で有効化する場合は、下の VONAGE_APPLICATION_ID と
# 同じ値・同じ鍵ファイル（例: ./private.key）を指定してよい。
VONAGE_VIDEO_APPLICATION_ID=
VONAGE_VIDEO_PRIVATE_KEY_PATH=./private.key

# --- Vonage Messages API (WhatsApp) ---
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
# 秘密鍵ファイルは backend/ 直下に配置（同一 Application なら Video と同じ鍵で可）。
VONAGE_PRIVATE_KEY_PATH=./private.key
# WhatsApp 送信元番号（サンドボックスまたは本番番号）
VONAGE_WHATSAPP_FROM=
# Messages API のホスト。空 = 本番（api.nexmo.com）。
# Messages API Sandbox を使う場合は https://messages-sandbox.nexmo.com を指定する。
VONAGE_MESSAGES_API_HOST=
# 受信 Webhook の署名検証用シークレット（JWT/署名）
# 【重要】NODE_ENV=production では、これらの変数が空だと fail-closed により
# Vonage からの Webhook がすべて 503 で拒否され、機能が動作しなくなります。
# 本番では必ず設定してください。
# NODE_ENV=development のときだけ、未設定でも警告ログを出してスキップします。

# Messages API (WhatsApp) 用署名シークレット
# Dashboard → Settings → Signed Webhooks で設定した値
VONAGE_MESSAGES_SIGNATURE_SECRET=

# Video API (Session Monitoring) 用署名シークレット
# Application → Video → Session Monitoring で設定した値
VONAGE_VIDEO_SESSION_MONITORING_SIGNATURE_SECRET=

# Video API (Archive Monitoring) 用署名シークレット
# Application → Video → Archiving → Configure Callback URL で設定した値
# （Session Monitoring とは別の個別設定）
VONAGE_VIDEO_ARCHIVE_MONITORING_SIGNATURE_SECRET=

# Messages API Sandbox 向けフォールバック。
# Sandbox は custom/interactive メッセージ（reply button / list / carousel）を非対応で HTTP 422 を返す。
# Sandbox でテストする場合は true にすると、インタラクティブ種別をプレーンテキスト
# （本文＋番号付き選択肢＋返信ヒント）へフォールバックして送信する。
# 本番の WhatsApp 番号では空 or false のままにする（従来のインタラクティブ送信）。
WHATSAPP_INTERACTIVE_FALLBACK_TEXT=false

# --- Notification Scheduler ---
# node-cron 式（デフォルト: 毎分）
NOTIFICATION_CRON=* * * * *
# リマインダー通知スケジューラ（既定: 毎時 0 分）。本番ではより頻繁（例: */15 * * * *）も可。
NOTIFICATION_REMINDER_CRON=0 * * * *
# リマインダーウィンドウ（ミリ秒）。既定: 24 時間前（予約時刻の 24h 前以内でリマインダー送信）。
NOTIFICATION_REMINDER_WINDOW_MS=86400000
# 10分前リマインダー通知スケジューラ（既定: 毎分実行）。本番では */1 * * * * も可。
NOTIFICATION_TEN_MIN_REMINDER_CRON=* * * * *
# 10分前リマインダーウィンドウ（ミリ秒）。既定: 10分前 ± 5分（計 10分間）。
NOTIFICATION_TEN_MIN_REMINDER_WINDOW_MS=600000
