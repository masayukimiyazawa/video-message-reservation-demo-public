{
  "name": "@vvr/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Vonage Video Reservation backend (Express, Vonage SDK, Mongoose, Socket.IO)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed:user": "node src/seedUser.js",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@vonage/auth": "^1.18.1",
    "@vonage/messages": "^1.27.1",
    "@vonage/server-sdk": "^3.30.1",
    "@vonage/video": "^1.31.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fflate": "0.8.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "node-cron": "^3.0.3",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "fast-check": "^3.19.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/*.test.js"
    ]
  }
}
